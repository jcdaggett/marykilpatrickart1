// Parse original painting dimensions from dims string
function parseDims(dims) {
  const clean = dims.replace('¾','0.75').replace('⅝','0.625').replace('¼','0.25');
  const m = clean.match(/([\d.]+)\s*[×x]\s*([\d.]+)/);
  return m ? { w: parseFloat(m[1]), h: parseFloat(m[2]) } : { w: 20, h: 20 };
}

// Generate size tiers at 25%, 50%, 75%, 100%, 125%, 150%, 175%, 200%
function getSizeTiers(painting) {
  const { w, h } = parseDims(painting.dims);
  const tiers = [0.25, 0.50, 0.75, 1.0, 1.25, 1.50, 1.75, 2.0];
  return tiers.map(t => ({
    pct: t,
    label: `${Math.round(t * 100)}%`,
    w: Math.round(w * t * 4) / 4,
    h: Math.round(h * t * 4) / 4,
    id: `${Math.round(t * 100)}pct`,
    price: null
  }));
}

// Estimate price proportionally from original painting price
function estimatePrice(painting, size) {
  const { w: ow, h: oh } = parseDims(painting.dims);
  const origArea = ow * oh;
  const printArea = size.w * size.h;
  const ratio = Math.sqrt(printArea / origArea);
  const pct = Math.max(0.08, Math.min(0.40, ratio * 0.22));
  return Math.max(50, Math.round(painting.originalPrice * pct / 5) * 5);
}

function totalPrice() {
  if (!selected.painting || !selected.paper || !selected.size) return null;
  return selected.size.price || estimatePrice(selected.painting, selected.size);
}

let inventoryData = {};

async function loadInventory() {
  try {
    const res = await fetch(`${WORKER_URL}/api/inventory`);
    if (!res.ok) throw new Error('bad response');
    const data = await res.json();
    inventoryData = data.inventory || {};
  } catch(e) {
    console.warn('Inventory load failed, rendering without counts:', e);
    inventoryData = {};
  }
}

function getSold(title) {
  const key = title.toLowerCase().replace(/\s+/g, '-');
  return inventoryData[key] || 0;
}

function getEditionSize(title) {
  const p = PAINTINGS.find(x => x.title === title);
  return p ? p.editionSize : 100;
}
function isSoldOut(title) {
  return getSold(title) >= getEditionSize(title);
}

function renderPaintings() {
  document.getElementById('paintings-grid').innerHTML = PAINTINGS.map((p,i) => {
    const sold = getSold(p.title);
    const remaining = Math.max(0, (p.editionSize || 100) - sold);
    const soldOut = sold >= (p.editionSize || 100);
    const pct = Math.min(100, (sold / (p.editionSize || 100)) * 100);
    return `
      <div class="painting-card${soldOut ? ' sold-out-card' : ''}" id="pcard-${i}" onclick="${soldOut ? '' : `selectPainting(${i})`}" style="${soldOut ? 'cursor:default;' : ''}">
        <div style="position:relative;">
          <img src="${p.thumb}" alt="${p.title}" loading="lazy" style="${soldOut ? 'opacity:0.4;filter:grayscale(30%);' : ''}">
          ${soldOut ? '<div class="sold-out-overlay"><span class="sold-out-badge">Edition Sold Out</span></div>' : ''}
        </div>
        <div class="painting-card-info">
          <h3>${p.title}</h3>
          <p class="card-price">${soldOut ? `First Edition Sold Out` : `${remaining} remaining`}</p>
          <div class="inventory-bar"><div class="inventory-fill" style="width:${pct}%"></div></div>
        </div>
      </div>
    `;
  }).join('');
}

function selectPainting(i) {
  if (isSoldOut(PAINTINGS[i].title)) return;
  document.querySelectorAll('.painting-card').forEach(c => c.classList.remove('selected'));
  document.getElementById(`pcard-${i}`).classList.add('selected');
  selected = { painting: PAINTINGS[i], paper: null, size: null };

  document.getElementById('config-img').src = `thumbs/${PAINTINGS[i].file}`;
  document.getElementById('config-title').textContent = PAINTINGS[i].title;
  document.getElementById('config-dims').textContent = 'Original: ' + PAINTINGS[i].dims;
