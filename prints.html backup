async function submitOrder() {
  const btn = document.getElementById('submit-btn');
  const fields = { firstName:'First Name', lastName:'Last Name', email:'Email', address1:'Address', city:'City', state:'State', zipCode:'ZIP Code' };
  for (const [id, label] of Object.entries(fields)) {
    if (!document.getElementById(id).value.trim()) {
      document.getElementById('card-errors').textContent = `${label} is required.`;
      return;
    }
  }

  btn.disabled = true;
  btn.innerHTML = '<span class="spinner"></span>Processing...';
  document.getElementById('card-errors').textContent = '';

  const total = totalPrice();

  try {
    // Create Stripe payment intent
    const piRes = await fetch(`${WORKER_URL}/api/payment-intent`, {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({
        amount: total,
        currency: 'usd',
        metadata: {
          painting: selected.painting.title,
          paper: selected.paper.name,
          size: `${selected.size.w}×${selected.size.h}"`,
          pct: selected.size.label,
        }
      })
    });
    const { clientSecret, error: piError } = await piRes.json();
    if (piError) throw new Error(piError);

    const firstName = document.getElementById('firstName').value.trim();
    const lastName = document.getElementById('lastName').value.trim();

    // Confirm payment
    const { error, paymentIntent } = await stripe.confirmCardPayment(clientSecret, {
      payment_method: {
        card: cardElement,
        billing_details: { name: `${firstName} ${lastName}`, email: document.getElementById('email').value.trim() }
      }
    });

    if (error) {
      document.getElementById('card-errors').textContent = error.message;
      btn.disabled = false;
      btn.innerHTML = 'Place Order';
      return;
    }

    // Submit to Lumaprints
    await fetch(`${WORKER_URL}/api/order`, {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({
        paymentIntentId: paymentIntent.id,
        order: {
          externalId: paymentIntent.id,
          shippingMethod: 'default',
          productionTime: 'regular',
          recipient: {
            firstName,
            lastName,
            email: document.getElementById('email').value.trim(),
            addressLine1: document.getElementById('address1').value.trim(),
            addressLine2: document.getElementById('address2').value.trim(),
            city: document.getElementById('city').value.trim(),
            state: document.getElementById('state').value,
            zipCode: document.getElementById('zipCode').value.trim(),
            country: document.getElementById('country').value || 'US',
            phone: document.getElementById('phone').value.trim(),
          },
          orderItems: [{
            externalItemId: String(Date.now()),
            subcategoryId: null,
            quantity: 1,
            file: { imageUrl: `https://www.marykilpatrick.com/${selected.painting.file}` },
            orderItemOptions: [],
            notes: `Paper: ${selected.paper.name}, Size: ${selected.size.w}×${selected.size.h}", Painting: ${selected.painting.title}`,
            printWidth: selected.size.w,
            printHeight: selected.size.h,
            paperType: selected.paper.id,
          }]
        }
      })
    });

    // Success
    document.getElementById('configurator').style.display = 'none';
    document.getElementById('order-success').classList.add('active');
    document.getElementById('order-success').scrollIntoView({ behavior:'smooth' });

  } catch (err) {
    document.getElementById('card-errors').textContent = `Error: ${err.message}. Please try again or contact art@marykilpatrick.com`;
    btn.disabled = false;
    btn.innerHTML = 'Place Order';
  }
}

async function joinWaitlist() {
  const email = document.getElementById('waitlist-email').value.trim();
  if (!email || !email.includes('@')) {
    document.getElementById('waitlist-msg').textContent = 'Please enter a valid email.';
    return;
  }
  try {
    await fetch(`${WORKER_URL}/api/waitlist`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ painting: selected.painting.title, email })
    });
    document.getElementById('waitlist-msg').textContent = "You're on the list. We'll be in touch.";
    document.getElementById('waitlist-email').value = '';
  } catch(e) {
    document.getElementById('waitlist-msg').textContent = 'Something went wrong. Please try again.';
  }
}


let frScale = 1, frDragging = false, frLastX = 0, frLastY = 0, frTransX = 0, frTransY = 0, frLastDist = 0;

function openFullRes() {
  if (!selected.painting) return;
  frScale = 1; frTransX = 0; frTransY = 0;
  const img = document.getElementById('fullres-img');
  img.style.transform = '';
  img.style.cursor = 'zoom-in';
  img.src = 'watermarked/' + selected.painting.file;
  document.getElementById('fullres-title').textContent = selected.painting.title;
  const lb = document.getElementById('fullres-lightbox');
  lb.style.display = 'flex';
  document.body.style.overflow = 'hidden';
}
function closeFullRes() {
  document.getElementById('fullres-lightbox').style.display = 'none';
  document.getElementById('fullres-img').src = '';
  document.body.style.overflow = '';
  frScale = 1; frTransX = 0; frTransY = 0;
}

// Scroll zoom
document.getElementById('fullres-lightbox').addEventListener('wheel', function(e) {
  e.preventDefault();
  const img = document.getElementById('fullres-img');
  frScale = Math.max(1, Math.min(5, frScale - e.deltaY * 0.002));
  if (frScale === 1) { frTransX = 0; frTransY = 0; }
  img.style.transform = `scale(${frScale}) translate(${frTransX}px, ${frTransY}px)`;
  img.style.cursor = frScale > 1 ? 'grab' : 'zoom-in';
}, { passive: false });

// Click to toggle zoom
document.getElementById('fullres-img').addEventListener('click', function(e) {
  e.stopPropagation();
  if (frScale > 1) {
    frScale = 1; frTransX = 0; frTransY = 0;
    this.style.transform = '';
    this.style.cursor = 'zoom-in';
  } else {
    frScale = 2.5;
    this.style.transform = `scale(${frScale})`;
    this.style.cursor = 'grab';
  }
});

// Drag to pan
const frImg = document.getElementById('fullres-img');
frImg.addEventListener('mousedown', function(e) {
  if (frScale <= 1) return;
  frDragging = true; frLastX = e.clientX; frLastY = e.clientY;
  this.style.cursor = 'grabbing'; e.preventDefault();
});
document.addEventListener('mousemove', function(e) {
  if (!frDragging) return;
  const img = document.getElementById('fullres-img');
  frTransX += (e.clientX - frLastX) / frScale;
  frTransY += (e.clientY - frLastY) / frScale;
  frLastX = e.clientX; frLastY = e.clientY;
  img.style.transform = `scale(${frScale}) translate(${frTransX}px, ${frTransY}px)`;
});
document.addEventListener('mouseup', function() {
  if (frDragging) { frDragging = false; if (frScale > 1) document.getElementById('fullres-img').style.cursor = 'grab'; }
});

// Pinch zoom mobile
document.getElementById('fullres-lightbox').addEventListener('touchstart', function(e) {
  if (e.touches.length === 2) frLastDist = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY);
}, { passive: true });
document.getElementById('fullres-lightbox').addEventListener('touchmove', function(e) {
  if (e.touches.length === 2) {
    e.preventDefault();
    const dist = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY);
    frScale = Math.max(1, Math.min(5, frScale * (dist / frLastDist)));
    frLastDist = dist;
    const img = document.getElementById('fullres-img');
    if (frScale === 1) { frTransX = 0; frTransY = 0; }
    img.style.transform = `scale(${frScale}) translate(${frTransX}px, ${frTransY}px)`;
  }
}, { passive: false });

document.addEventListener('keydown', e => { if (e.key === 'Escape') closeFullRes(); });


// Pre-select painting from URL hash
function checkHashSelection() {
  const hash = decodeURIComponent(window.location.hash.replace('#',''));
  if (!hash) return;
  const idx = PAINTINGS.findIndex(p => p.title === hash);
  if (idx >= 0) {
    loadInventory().then(() => {
      renderPaintings();
      setTimeout(() => selectPainting(idx), 300);
    });
  }
}

function clearSelection() {
  selected = { painting:null, paper:null, size:null };
  document.querySelectorAll('.painting-card').forEach(c => c.classList.remove('selected'));
  document.getElementById('configurator').classList.remove('active');
  window.scrollTo({ top: document.getElementById('paintings-grid').offsetTop - 100, behavior:'smooth' });
}

loadInventory().then(() => { renderPaintings(); checkHashSelection(); });

// Mobile nav dropdown toggle
document.querySelectorAll('.nav-dropdown-toggle').forEach(toggle => {
  toggle.addEventListener('click', function(e) {
    const menu = this.nextElementSibling;
    if (window.innerWidth <= 900) {
      e.preventDefault();
      menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
    }
  });
});
document.addEventListener('click', function(e) {
  if (!e.target.closest('.nav-dropdown')) {
    document.querySelectorAll('.nav-dropdown-menu').forEach(m => m.style.display = '');
  }
});
</script>
