async function selectSize(sizeId) {
  const tiers = getSizeTiers(selected.painting);
  const size = tiers.find(s => s.id === sizeId);
  if (!size) return;

  document.querySelectorAll('#size-options .option-btn').forEach(b => b.classList.remove('selected'));
  const btn = document.getElementById(`size-${sizeId}`);
  if (btn) btn.classList.add('selected');

  selected.size = size;

  // Clear price summary until real price loads
  document.getElementById('price-summary').style.display = 'none';
  document.getElementById('checkout-btn').style.display = 'none';

  // Fetch real Lumaprints price
  const priceEl = document.getElementById(`price-${sizeId}`);
  if (priceEl) priceEl.textContent = 'Loading...';

  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), 10000);
  try {
    const res = await fetch(`${WORKER_URL}/api/price`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        width: size.w,
        height: size.h,
        paperType: selected.paper.id
      }),
      signal: controller.signal
    });
    clearTimeout(timeout);
    const data = await res.json();
    if (data.lumaPrice && data.lumaPrice > 0) {
      const marked = Math.round(data.lumaPrice * 2.5 / 5) * 5;
      selected.size.price = Math.max(50, marked);
      if (priceEl) priceEl.textContent = `$${selected.size.price.toLocaleString()}`;
      updatePriceSummary();
    } else if (data.error) {
      console.warn('Price API error:', data.error, data.detail);
      if (priceEl) priceEl.textContent = 'Price unavailable';
      selected.size.price = null;
    } else {
      if (priceEl) priceEl.textContent = 'Price unavailable';
      selected.size.price = null;
    }
  } catch(e) {
    clearTimeout(timeout);
    console.warn('Price fetch failed:', e.message);
    if (priceEl) priceEl.textContent = e.name === 'AbortError' ? 'Timeout — try again' : 'Price unavailable';
    selected.size.price = null;
  }
}

function updatePriceSummary() {
  if (!selected.painting || !selected.paper || !selected.size) return;
  const price = totalPrice();
  document.getElementById('total-price-display').textContent = `$${price.toLocaleString()}`;
  document.getElementById('price-summary').style.display = 'block';
  document.getElementById('checkout-btn').style.display = 'block';
}

